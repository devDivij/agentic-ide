# Copy to .env and fill in whichever you have. The system runs with any subset;
# keys can also be entered on the Settings screen in the UI.
#
# Provider ids match server/src/agent/providers.ts
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Local Ollama needs no key; set the base url only if it is not the default.
# OLLAMA_BASE_URL=http://localhost:11434/v1
