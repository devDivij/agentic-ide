{
  "name": "agent-zero",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "server",
    "ui"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node server/scripts/dev.mjs",
    "server": "npm run dev -w server",
    "ui": "npm run dev -w ui",
    "cli": "npm run cli -w server --",
    "test": "npm run test -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w ui"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
